# Salin menjadi .streamlit/secrets.toml (jangan di-commit). Di Streamlit Cloud isi lewat App settings -> Secrets.
GEMINI_API_KEY = "isi-kunci-dari-google-ai-studio"
GEMINI_MODEL = "gemini-3.5-flash-lite"   # samakan persis dengan model ID di Google AI Studio

# Opsional
# LLM_ENABLED = "false"          # matikan fitur AI sepenuhnya
# LLM_RPM_HIDE_AT = "8"          # sembunyikan tombol AI bila permintaan per menit >= nilai ini
# LLM_SESSION_MAX_CALLS = "8"    # batas panggilan per sesi pengguna
# GEMINI_MAX_OUTPUT_TOKENS = "600"
