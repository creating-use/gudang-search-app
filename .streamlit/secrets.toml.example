# Salin menjadi .streamlit/secrets.toml (jangan di-commit). Di platform deploy, isi lewat menu Secrets.
GEMINI_API_KEY = "isi-kunci-api-anda"
GEMINI_MODEL = "isi-model-id-yang-tersedia-di-akun-anda"

# Opsional
# LLM_ENABLED = "false"          # matikan fitur AI sepenuhnya
# LLM_RPM_LIMIT = "..."          # batas permintaan per menit pada akun Anda
# LLM_RPM_HIDE_AT = "..."        # sembunyikan tombol AI bila permintaan per menit >= nilai ini
# LLM_SESSION_MAX_CALLS = "..."  # batas panggilan AI per sesi pengguna
# GEMINI_MAX_OUTPUT_TOKENS = "..."
# LLM_DEBUG = "true"             # panel diagnostik (hanya untuk uji, lalu matikan)
